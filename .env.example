# Browser-safe Supabase client configuration is returned by /api/public/config at runtime.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Flutterwave configuration.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Browser-visible application origin, e.g. https://example.com. Used only on the server to create Flutterwave callback URLs.
APP_ORIGIN=

# Optional: required only after active resource records use a Supabase Storage path instead of an external URL.
SUPABASE_RESOURCE_BUCKET=
